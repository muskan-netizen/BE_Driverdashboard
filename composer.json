{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": ["framework", "laravel"],
    "license": "MIT",

    "require": {
        "php": "7.4.33",

        "laravel/framework": "^7.30",
        "laravel/tinker": "^2.5",
        "laravel/ui": "^2.4",
        "laravelcollective/html": "^6.2",

        "artisangang/jwt": "^0.2.0",
        "lcobucci/jwt": "3.3.3",

        "barryvdh/laravel-dompdf": "^0.9.0",
        "intervention/image": "^2.5",
        "maatwebsite/excel": "^3.1",

        "bavix/laravel-wallet": "^7.3",
        "beyondcode/laravel-websockets": "^1.13",
        "cboden/ratchet": "^0.4.4",
        "ratchet/rfc6455": "^0.3.1",

        "doctrine/dbal": "^2.13",
        "fideloper/proxy": "^4.2",
        "fruitcake/laravel-cors": "^1.0",

        "geocoder-php/nominatim-provider": "^5.7",
        "google/auth": "^1.37",

        "guzzlehttp/guzzle": "^7.5",

        "kreait/laravel-firebase": "^2.4",
        "kawankoding/laravel-fcm": "^0.2.0",

        "league/flysystem-aws-s3-v3": "~1.0",
        "league/omnipay": "^3.2",

        "microsoft/azure-storage-blob": "^1.5",
        "multicaret/laravel-unifonic": "^2.0",

        "omnipay/stripe": "^3.1",
        "paystackhq/omnipay-paystack": "^1.0",
        "razorpay/razorpay": "2.*",
        "stripe/stripe-php": "^7.116",

        "predis/predis": "^1.1",

        "pusher/pusher-php-server": "^4.1",

        "react/event-loop": "^1.5",
        "react/react": "^1.2",
        "react/socket": "^1.10",

        "rinvex/countries": "^6.1",

        "sarav/laravel-multiauth": "dev-master",

        "sentry/sentry-laravel": "^2.10",

        "symfony/http-foundation": "^5.4",
        "symfony/routing": "^5.4",

        "twilio/sdk": "^6.13",
        "vonage/client": "2.4.0",

        "yajra/laravel-datatables-oracle": "~9.0"
    },

    "require-dev": {
        "barryvdh/laravel-debugbar": "^3.7",
        "facade/ignition": "^2.5",
        "fzaninotto/faker": "^1.9.1",
        "mockery/mockery": "^1.3.1",
        "nunomaduro/collision": "^4.1",
        "oscarafdev/migrations-generator": "^2.0",
        "phpunit/phpunit": "^8.5"
    },

    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "platform": {
            "php": "7.4.33"
        },
        "allow-plugins": {
            "php-http/discovery": false
        }
    },

    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "classmap": [
            "database/seeds",
            "database/factories"
        ],
        "files": [
            "app/helpers.php"
        ]
    },

    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },

    "minimum-stability": "dev",
    "prefer-stable": true,

    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    }
}
